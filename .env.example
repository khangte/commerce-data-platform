# PostgreSQL (Phase 1)
POSTGRES_USER=commerce_admin
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433
COMMERCE_SOURCE_DB=commerce_source
AIRFLOW_METADATA_DB=airflow_metadata
PIPELINE_METADATA_DB=pipeline_metadata
SOURCE_DB_USER=commerce_source_rw
SOURCE_DB_PASSWORD=change_me
AIRFLOW_DB_USER=airflow_metadata_rw
AIRFLOW_DB_PASSWORD=change_me
PIPELINE_DB_USER=pipeline_metadata_rw
PIPELINE_DB_PASSWORD=change_me

# SeaweedFS S3 API (Phase 3)
SEAWEEDFS_HOST=localhost
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ACCESS_KEY=commerce_access_key
SEAWEEDFS_SECRET_KEY=change_me
SEAWEEDFS_BUCKET=commerce-lake

# Airflow and ingestion
# Linux/WSL에서는 `id -u` 결과로 바꾼다. 예: 1000
AIRFLOW_UID=1000
AIRFLOW_PORT=8080
AIRFLOW_PARALLELISM=6
WAREHOUSE_DAG_SCHEDULE=
INGESTION_PAGE_SIZE=50000

# BI (Phase 9)
METABASE_PORT=3000

# Test opt-in (환경 변수로만 사용, .env에 넣지 않아도 됨)
# RUN_AIRFLOW_SMOKE_TEST=1  # tests/test_airflow_dags.py: airflow Compose Profile 빌드/기동
# RUN_SEAWEEDFS_INTEGRATION=1
