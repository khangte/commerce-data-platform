        "lib/type": "mbql.stage/native",
        "native": "select fct_order.customer_state, sum(fct_order.order_count) as order_count\nfrom facts.fct_order\ninner join dimensions.dim_date on fct_order.purchase_date_key = dim_date.date_key\nwhere 1 = 1\n[[and {{utc_order_date}}]]\ngroup by fct_order.customer_state\norder by order_count desc",
